# Copy this file to .env and replace with your Google AI Studio API key
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used for course generation
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Recommended for production builds: point to your deployed functions/aiProxy.js URL
# so the Gemini API key stays on the server instead of the client app
# EXPO_PUBLIC_AI_PROXY_URL=https://<region>-<project-id>.cloudfunctions.net/aiProxy

# Optional: point the app at your own Firebase project (if you don't own projects-2025-1b302)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
