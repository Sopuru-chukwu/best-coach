# Copy this file to .env.
# Local development only: a direct Google AI Studio key. It is ignored in release
# builds (it would be extractable from the app), which must use the proxy below.
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used for course generation
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# REQUIRED for release builds: the URL of the deployed aiProxy Cloud Function
# (see functions/aiProxy.js). The Gemini key stays on the server.
# EXPO_PUBLIC_AI_PROXY_URL=https://<region>-<project-id>.cloudfunctions.net/aiProxy

# Optional: point the app at your own Firebase project (defaults to best-coach-704b6)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
